# Copy to .env and edit. Restart the app after changes.

# --- Language model (leave as "offline" to run without any API key) ---
RAG_PROVIDER=offline
# RAG_PROVIDER=openai
# RAG_PROVIDER=anthropic
RAG_MODEL=
RAG_API_KEY=

# --- Embeddings ---
# huggingface = sentence-transformers, downloaded once (~90 MB) and run locally on CPU
# hashing     = dependency-free lexical embedder for tests/CI (not semantic)
RAG_EMBEDDINGS=huggingface
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4

# --- Agent ---
RAG_WEB_SEARCH=true
RAG_AGENT_MAX_STEPS=6

# --- Storage ---
RAG_DATA_DIR=.ragdata
RAG_MAX_UPLOAD_MB=10
